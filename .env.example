# PostgreSQL (docker-compose)
POSTGRES_USER=etf
POSTGRES_PASSWORD=etf
POSTGRES_DB=etf_analytics
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Airflow (docker-compose defaults; change in production)
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Ingest
ETF_TICKERS=SGOV,VGIT
RAW_DATA_DIR=data/raw

# dbt
DBT_PROFILE=etf_analytics
DBT_TARGET=dev
