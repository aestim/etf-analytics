# PostgreSQL (docker-compose)
POSTGRES_USER=etf
POSTGRES_PASSWORD=etf
POSTGRES_DB=etf_analytics
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Airflow (docker-compose defaults; change in production)
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Ingest
ETF_TICKERS=SGOV,VGIT,TLT,BND,LQD,HYG,TIP,SPY,QQQ,QLD,TQQQ,VEA,SCHD,VWO,IWM,VNQ,GLD
RAW_DATA_DIR=data/raw

# dbt
DBT_PROFILE=etf_analytics
DBT_TARGET=dev

# LLM Q&A layer
GEMINI_API_KEY=
# Pin stable model IDs instead of `*-latest`, which Google may hot-swap.
# The app retries 503 capacity errors and then falls back to the next model.
GEMINI_MODEL_CHAIN=gemini-3.5-flash,gemini-3.1-flash-lite
# Optional: force one model to the head of the chain while diagnosing an outage.
# GEMINI_MODEL=gemini-3.1-flash-lite
# read-only warehouse access — see scripts/init_db.sql
QA_DB_USER=etf_reader
QA_DB_PASSWORD=etf_reader

# Fetch window (10y needed for long-horizon Strategy Lab backtests)
FETCH_PERIOD=10y
